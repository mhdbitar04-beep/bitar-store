APP_NAME="BITAR STORE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# URL of the React app (used for CORS and password-reset / Stripe redirect links)
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bitar_store
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@bitarstore.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Store settings ----
STORE_CURRENCY=usd
# Flat shipping in cents, free above threshold (cents)
STORE_SHIPPING_FLAT=799
STORE_FREE_SHIPPING_OVER=15000
# Tax rate in percent (e.g. 0, 5, 11)
STORE_TAX_RATE=0

# ---- Payments ----
# stripe | fake   (fake = no network, used by tests / offline demo)
PAYMENT_GATEWAY=stripe
# Test-mode keys from https://dashboard.stripe.com/test/apikeys  (NEVER commit real keys)
STRIPE_KEY=pk_test_xxx
STRIPE_SECRET=sk_test_xxx
# From `stripe listen --forward-to localhost:8000/api/v1/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_xxx
